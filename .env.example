# 复制为 .env 后按需修改；不复制则使用 docker-compose.yml 中的默认值

# Redis 访问密码（slink 与 Redis 共用此值）
REDIS_PASSWORD=slink123

# slink 首次启动的初始登录账号（之后可在「设置」页修改）
SLINK_USERNAME=admin
SLINK_PASSWORD=admin123

# 管理后台隐藏入口（强烈建议设置）：配置后根路径与 /login 一律 404，
# 管理界面只在 https://你的域名/这个路径 下可见。2-32 位字母/数字/-/_，用随机的难猜值
# SLINK_ADMIN_PATH=my-secret-panel

# 前置 Nginx/Caddy 反代时必填：代理在容器里呈现的来源 IP（留空则不信任任何代理头）。
# 查法：随便请求一次后看 docker compose logs slink，日志里显示的那个 IP 就是它
# SLINK_SERVER_TRUSTED_PROXIES=172.19.0.1
